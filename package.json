{
  "name": "cinematic-los-angeles",
  "version": "0.1.0",
  "description": "A street atlas of fictional lives in Los Angeles.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --test tests/*.test.mjs",
    "check:affected": "npm run check && npm run build"
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
